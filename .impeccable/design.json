  "components": [
    {
      "name": "Kartusche",
      "kind": "card",
      "refersTo": "kartusche",
      "description": "Gerahmter Titelblock wie auf einer gedruckten Sternkarte.",
      "html": "<div class=\"ds-kartusche\"><h1>Resonanz</h1><p>Himmelsatlas meiner Musik</p></div>",
      "css": ".ds-kartusche{position:relative;border:1px solid var(--linie);background:rgba(7,9,20,.72);padding:14px 16px 12px;max-width:290px;color:var(--text);font-family:var(--schrift)} .ds-kartusche::after{content:'';position:absolute;inset:3px;border:1px solid var(--gitter);pointer-events:none} .ds-kartusche h1{margin:0;font-size:28px;line-height:1;font-weight:700;letter-spacing:-.02em;font-variation-settings:'opsz' 96,'wdth' 90} .ds-kartusche p{margin:5px 0 0;color:var(--text-2);font-size:13px}"
    },
    {
      "name": "Zeitraum-Schalter",
      "kind": "nav",
      "refersTo": "zeit-schalter-knopf",
      "description": "Drei Zeiträume, Bernstein-Cursor als Lauflicht.",
      "html": "<div class=\"ds-zeit\"><button class=\"ds-on\">4 W</button><button>6 M</button><button>1 J</button></div>",
      "css": ".ds-zeit{display:inline-grid;grid-auto-flow:column;border:1px solid var(--linie);font-family:var(--schrift)} .ds-zeit button{padding:7px 14px;font-size:13px;font-weight:500;color:var(--text-2);background:none;border:0;box-shadow:inset 1px 0 var(--linie);cursor:pointer;transition:color .25s} .ds-zeit button:first-child{box-shadow:none} .ds-zeit button:hover{color:var(--text)} .ds-zeit button:focus-visible{outline:1px solid var(--bernstein);outline-offset:3px} .ds-zeit .ds-on{background:var(--bernstein);color:var(--grund)}"
    },
    {
      "name": "Legendenknopf",
      "kind": "chip",
      "refersTo": "zeit-schalter-knopf",
      "description": "Hörwelt als beleuchtete Beschriftung mit Sternanzahl.",
      "html": "<button class=\"ds-legende\"><i></i>Deutschrap <b>41</b></button>",
      "css": ".ds-legende{display:inline-flex;align-items:center;gap:8px;padding:6px 10px 6px 8px;border:1px solid var(--bernstein);background:none;font:12px var(--schrift);color:var(--text);letter-spacing:.02em;cursor:pointer} .ds-legende i{width:8px;height:8px;border-radius:50%;background:#ff4fa3} .ds-legende b{font:400 11px var(--mono);color:var(--text-3);font-variant-numeric:tabular-nums} .ds-legende:focus-visible{outline:1px solid var(--bernstein);outline-offset:3px}"
    },
    {
      "name": "Hauptknopf (Dialog)",
      "kind": "button",
      "refersTo": "eg-haupt",
      "description": "Einzige gefüllte Bernstein-Fläche.",
      "html": "<button class=\"ds-haupt\">Himmel laden</button>",
      "css": ".ds-haupt{padding:7px 12px;border:1px solid var(--bernstein);background:var(--bernstein);color:var(--grund);font:600 13px var(--schrift);cursor:pointer} .ds-haupt:hover{filter:brightness(1.08)} .ds-haupt:focus-visible{outline:1px solid var(--bernstein);outline-offset:3px}"
    },
    {
      "name": "Eingabefeld",
      "kind": "input",
      "refersTo": "eingabe",
      "description": "Mono-Eingabe im Dialog.",
      "html": "<input class=\"ds-eingabe\" value=\"abc-123\">",
      "css": ".ds-eingabe{background:var(--grund-2);border:1px solid var(--linie);color:var(--text);font:13px var(--mono);padding:8px 10px} .ds-eingabe:focus{border-color:var(--bernstein);outline:none}"
    },
    {
      "name": "Messtabelle",
      "kind": "custom",
      "refersTo": "tafel",
      "description": "Zahlen gemessen: Mono, rechts, Rotlicht, Linie je Zeile.",
      "html": "<table class=\"ds-mess\"><tr><th>Künstler</th><th class=\"z\">Hörzeit</th></tr><tr><td>Beispiel</td><td class=\"z\">12 h</td></tr></table>",
      "css": ".ds-mess{width:100%;border-collapse:collapse;font:14px var(--schrift);color:var(--text)} .ds-mess th{text-align:left;font-weight:500;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--text-3);padding:0 0 6px;border-bottom:1px solid var(--linie)} .ds-mess td{padding:7px 0;border-bottom:1px solid var(--gitter)} .ds-mess .z{text-align:right;font-family:var(--mono);font-variant-numeric:tabular-nums;color:var(--rot);font-size:13px;padding-left:14px}"
    }
  ],
  "narrative": {
    "northStar": "Der Himmelsatlas bei Nachtfahrt",
    "overview": "Die Szene ist das Werk, die Oberfläche tritt zurück. Ein tiefindigoblauer Nachthimmel trägt Sterne (Künstler) und Galaxien (Hörwelten). Bedienung sieht aus wie Gerät und Karte: dünne Rahmen, ein Armaturenbrett, Bernsteinlicht für Aktives, Rotlicht für Zahlen. Flach, eckig, ohne Verläufe in der Bedienebene; ohne Bewegung ist der Himmel eine fertige gedruckte Sternkarte.",
    "keyCharacteristics": [
      "Tiefindigo-Grund (#070914), Himmelsgitter in #1a2140.",
      "Eine Bedienfarbe (Bernstein), eine Zahlenfarbe (Rotlicht), acht feste Weltfarben.",
      "Linien 1 px, Ecken eckig, doppelter Rahmen als Kartuschen-Signatur.",
      "Bricolage Grotesque eng für Titel, Azeret Mono tabellarisch für Gemessenes.",
      "Ohne Bewegung ist der Himmel eine fertige gedruckte Sternkarte."
    ],
    "rules": [
      {
        "name": "The One Lamp Rule",
        "body": "Bernstein ist die einzige Bedienfarbe; Rotlicht gehört nur Zahlen. Weltfarben bezeichnen nur Welten, nie Knöpfe oder Zustände.",
        "section": "colors"
      },
      {
        "name": "The Fixed Palette Rule",
        "body": "Neun Weltfarben, fest. Keine Verläufe in der Bedienebene; Transparenz nur als dunkle Tönung von --grund.",
        "section": "colors"
      },
      {
        "name": "The Gemessen Rule",
        "body": "Jede Zahl steht in Azeret Mono, tabellarisch, in Rotlicht, mit einer Linie darunter. Keine Zahl wird groß inszeniert.",
        "section": "typography"
      },
      {
        "name": "The Letter-Space Rule",
        "body": "Weiter Buchstabenabstand nur bei Versalien-Beschriftungen in --text-3; Titel laufen eng (negativ).",
        "section": "typography"
      },
      {
        "name": "The Flat Glass Rule",
        "body": "Tafeln sind flache, dunkel getönte Platten mit Linienrahmen. Lichtglühen markiert nur Aktives; Versatzschatten gibt es nicht.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** Bernstein (#ffb454) für alles Bedienbare und Aktive verwenden, Rotlicht (#ff5a3c) nur für Zahlen in Azeret Mono.",
      "**Do** neue Flächen als 1-px-gerahmte, eckige Platten auf `rgba(7,9,20,.72 bis .92)` bauen, bei Hauptblöcken mit innerem `--gitter`-Rahmen 3 px eingerückt.",
      "**Do** Zahlen tabellarisch setzen (`font-variant-numeric: tabular-nums`) und mit einer Linie belegen, wie in `.mess`.",
      "**Do** Zeitraum-Wechsel mit dem gleitenden Cursor und `--ease` (cubic-bezier(.16, 1, .3, 1)) bewegen: träge wie eine schwere Kamera.",
      "**Do** bei `prefers-reduced-motion` eine fertige statische Karte liefern (Übergänge 0, Animationen aus), nicht eine abgeschaltete.",
      "**Do** Fokus mit 1-px-Bernsteinring, 3 px Abstand zeigen (`--fokus`)."
    ],
    "donts": [
      "**Don't** Weltfarben für Knöpfe, Links oder Zustände benutzen; sie bezeichnen nur Welten.",
      "**Don't** Wrapped-Karten mit Verlauf und riesiger Zahl oder Balken-Ranglisten bauen; die Daten stehen im Raum.",
      "**Don't** Radius, Pillen, Schlagschatten oder Weichzeichner-Glas in die Bedienebene bringen; Verläufe gibt es nur als Horizontglühen.",
      "**Don't** reines Schwarz als Grund nehmen; Grund ist Tiefindigo.",
      "**Don't** Text kleiner als 11 px oder dunkler als `--text-3` setzen.",
      "**Don't** Daten erfinden, die nicht vorliegen (Uhrzeit- und Monatsauswertungen nur aus einem echten Verlauf)."
    ]
  }
}